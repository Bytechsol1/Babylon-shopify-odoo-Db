# Server settings for /opt/babylon/.env. Fill in the CHANGE_ME values. This file holds secrets: chmod 600.

# ---- Database: Supabase Postgres (Connect -> Session pooler, or the direct URL if the instance has IPv6).
# An @ in the password must be written as %40.
DATABASE_URL=CHANGE_ME
DB_SCHEMA=babylon

# ---- Logins: Supabase Auth. Only these emails (or @domain) may use the station.
AUTH=supabase
SUPABASE_URL=https://mnhaibeqomrifpvyzujw.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
ALLOWED_EMAILS=@babylonllc.com

# ---- Shopify: the test store, taking orders
SHOPIFY_MODE=live
SHOPIFY_SHOP=toolbox-test-2.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=CHANGE_ME
SHOPIFY_CLIENT_SECRET=CHANGE_ME
BABYLON_LOCATION_ID=gid://shopify/Location/85797830817
UFSI_LOCATION_ID=gid://shopify/Location/78134116513
CLAIM_MODE=live
POLL_SECONDS=60
SYNC_SECONDS=0
ALLOW_MOCK_SYNC=1

# ---- Not connected yet
ODOO_MODE=mock
DEPOSCO_MODE=off
EASYPOST_MODE=mock
PRINTER_MODE=file

# ---- Labels
SHIP_FROM_NAME=Babylon LLC
SHIP_FROM_STREET1=2221 Oakland Rd
SHIP_FROM_CITY=San Jose
SHIP_FROM_STATE=CA
SHIP_FROM_ZIP=95131
SHIP_FROM_PHONE=4158149788
