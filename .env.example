# ---- Modes (POC defaults: everything mocked) ----
SHOPIFY_MODE=mock            # mock | live
EASYPOST_MODE=mock           # mock | live  (live = EasyPost TEST key first)
PRINTER_MODE=file            # file (writes .zpl to var/labels) | tcp (Zebra on port 9100)
DEPOSCO_MODE=mock            # mock | off | live. With SHOPIFY_MODE=live, mock is refused: off skips the check and
                             # says so on every label, live blocks every label until UFSI gives us access
CLAIM_MODE=live              # live | shadow  (shadow = log decisions, claim nothing)

# ---- Shopify (needed when SHOPIFY_MODE=live) ----
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_WEBHOOK_SECRET=xxx
SHOPIFY_API_VERSION=2026-07  # confirm the version the store should use
BABYLON_LOCATION_ID=gid://shopify/Location/0000000000
UFSI_LOCATION_ID=gid://shopify/Location/0000000001

# ---- Eligibility ----
IMPORT_TZ=America/Chicago
IMPORT_MARGIN_MIN=3          # claim only if more than this many minutes remain before the :00 import
DOMESTIC_COUNTRY=US
SKU_ALLOWLIST=               # comma list; empty = any SKU Babylon has in stock
DAILY_CAP=0                  # 0 = no cap

# ---- EasyPost (needed when EASYPOST_MODE=live) ----
EASYPOST_API_KEY=EZTK_xxx
NOTIFY_CUSTOMER=auto         # auto (email only with a production EZAK key) | on | off
SHIP_FROM_NAME=Babylon LLC
SHIP_FROM_STREET1=123 Example St
SHIP_FROM_CITY=San Jose
SHIP_FROM_STATE=CA
SHIP_FROM_ZIP=95112
SHIP_FROM_PHONE=4085550100

# ---- Printer (PRINTER_MODE=tcp) ----
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# ---- Background jobs (seconds, 0 = off) ----
POLL_SECONDS=0
SYNC_SECONDS=0
